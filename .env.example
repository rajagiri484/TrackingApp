# Google Cloud Console → APIs & Services → Credentials
# Enable "Maps SDK for iOS" and "Maps SDK for Android" for this key.
# Restrict the key by bundle id / SHA-256 for production.
GOOGLE_MAPS_API_KEY=

# FCM: replace `config/firebase/google-services.json` and `GoogleService-Info.plist`
# with files from Firebase Console (same package/bundle: com.trackingapp.fleet). Use a dev build — not Expo Go.
